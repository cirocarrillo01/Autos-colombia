# =============================================================================
# Auto Colombia - .gitignore
# =============================================================================

# Dependencias
node_modules/
package-lock.json
docs
documentacion

# Entorno (no versionar secretos ni credenciales)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Builds y distribuciones
dist/
build/
.next/
out/
.turbo/

# Vite
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs específicos del backend de este proyecto
backend/server_out.log
backend/server_err.log
backend/server_test.log
backend/server_test.err
backend/srv.log
backend/srv.err.log
backend/pruebas_out.txt
backend/seed_reset.txt
backend/seed_run1.txt
backend/seed_run2.txt
backend/ver_borrar.txt
backend/ver_tras_reset.txt

# IDE y editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db

# Cobertura de pruebas
coverage/
.nyc_output/
frontend/coverage/

# Resultados de Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# SonarQube
.scannerwork/
.sonar/
# sonar-project.properties <- Es mejor mantenerlo si es la configuración del proyecto, pero ignoramos los reportes generados si los hubiera fuera de coverage

# TypeScript (si se añade en el futuro)
*.tsbuildinfo

# Scripts de utilidad (temporales o locales)
*.mjs
*.inc
*.ps1
cambios_backend.mjs
aplicar_vehiculo.mjs
aplicar_movimiento.mjs
verificar_documentos.mjs
helper_vehiculo.inc
