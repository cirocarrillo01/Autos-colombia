# ============================================================================
# CONFIGURACION DE ENTORNO - BACKEND AUTO COLOMBIA
# ============================================================================

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto en el que escuchar el servidor Express
PORT=3000

# --- MySQL 8.0.19 o superior ---
DB_HOST=localhost
DB_PORT=3306
# Usa un usuario con permisos solo sobre esta BD (ver README), no root
DB_USER=root
DB_PASSWORD=pass1234
DB_NAME=autos_colombia

# --- Servidor / CORS ---
# Numero de proxies delante de la app (0 = ninguno)
TRUST_PROXY=0
# Origen permitido por CORS (frontend en Vite)
CORS_ORIGIN=http://localhost:5173
# La cookie de sesion solo viaja cifrada cuando hay HTTPS
COOKIE_SECURE=false

# --- Base de datos (opcional) ---
# Si se define, tiene prioridad sobre DB_* (formato: mysql://usuario:clave@host:puerto/basededatos)
# DATABASE_URL=mysql://root:clave@localhost:3306/autos_colombia

