{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend de Auto Colombia - ingreso y salida de vehiculos (Express + MySQL nativo)",
  "license": "ISC",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "seed:pruebas": "node src/seed/seedPruebas.js",
    "test": "$env:NODE_ENV='test'; $env:DB_NAME='autos_colombia_test'; node --test --test-force-exit test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/**/*.test.js",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@sonar/scan": "^5.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
